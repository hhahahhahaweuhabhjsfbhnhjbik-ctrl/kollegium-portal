# HTTP server
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
COOKIE_SECURE=true

# Public DuckDNS hostname served by Caddy
DOMAIN=yourname.duckdns.org

# Persistent SQLite database on the hosting server
DB_PATH=/var/data/portal.sqlite

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://yourname.duckdns.org/api/discord/callback

# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional Discord roles
DISCORD_ROLE_CITIZEN=
DISCORD_ROLE_TRAINEE=
DISCORD_ROLE_LAWYER=
DISCORD_ROLE_ATTORNEY=
DISCORD_ROLE_SENIOR_ATTORNEY=
DISCORD_ROLE_DEPUTY_HEAD=
DISCORD_ROLE_HEAD=

# Optional Discord webhooks
DISCORD_WEBHOOK_APPLICATIONS=
DISCORD_WEBHOOK_EXAMS=
DISCORD_WEBHOOK_LAWYER_TEST=
DISCORD_WEBHOOK_ATTORNEY_INTERVIEW=
DISCORD_WEBHOOK_LOGS=
DISCORD_WEBHOOK_HELP=
DISCORD_WEBHOOK_CALLS=
DISCORD_WEBHOOK_BAILS=
